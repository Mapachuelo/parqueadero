{
  "name": "parqueadero",
  "version": "1.0.0",
  "description": "Sistema de Gestion de Parqueaderos Publicos - Neiva, Colombia",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "pnpm --filter @parqueadero/client dev",
    "build": "tsc",
    "build:client": "pnpm --filter @parqueadero/client build",
    "build:all": "pnpm build:client && pnpm build",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/db/seeds/index.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/static": "^8.0.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-zod": "^1.0.0",
    "@fastify/under-pressure": "^9.0.3",
    "@prisma/client": "^6.0.0",
    "autoskills": "^0.3.6",
    "bcrypt": "^5.1.0",
    "date-fns": "^4.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.18.0",
    "prisma": "^6.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "prisma-dbml-generator": "^0.12.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.0.0"
  }
}
