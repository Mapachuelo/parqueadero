# Variables de entorno - ejemplo
# Copiar a .env y reemplazar con claves reales generadas con:
#   DATABASE_URL:        postgresql://usuario:password@localhost:5432/parqueadero
#   JWT_SECRET:          openssl rand -hex 32
#   PLATE_ENCRYPTION_KEY: openssl rand -hex 32   (exactamente 64 caracteres hex)
#   SYNC_API_KEY:        openssl rand -hex 16
# El contenedor rechaza valores placeholder (CAMBIAR_POR_*) al arrancar.
# Las credenciales de usuarios NO van aqui: el primer arranque las genera
# aleatoriamente y las imprime una sola vez en el log del contenedor.
DATABASE_URL=postgresql://usuario:password@localhost:5432/parqueadero
SQLITE_PATH=./data/local.db
JWT_SECRET=cambiar-por-una-clave-segura-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=30
PLATE_ENCRYPTION_KEY=cambiar-por-una-clave-de-encriptacion-de-exactamente-64-caracteres-abcdefgh
SYNC_API_KEY=cambiar-por-un-uuid-o-clave-de-al-menos-16-caracteres
PORT=3000
NODE_ENV=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Parqueadero Neiva <parqueadero@email.com>"
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups